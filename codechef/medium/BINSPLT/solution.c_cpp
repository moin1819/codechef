#include <iostream>
#include <string>
#include <vector>

using namespace std;

void solve() {
    int N;
    cin >> N;
    string S;
    cin >> S;

    // Check if "01" is a substring of S
    if (S.find("01") != string::npos) {
        cout << "01\n";
    } else {
        cout << S << "\n";
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int T;
    cin >> T;
    while (T--) {
        solve();
    }

    return 0;
}