#include <iostream>
using namespace std;

int main() {
    long long N;
    cin >> N;
    
    long long sum = 0;
    long long product = 1;
    
    while (N > 0) {
        int digit = N % 10; 
        sum += digit;
        product *= digit;
        N /= 10;            
    }
    
    cout << sum << " " << product << endl;
    
    return 0;
}